# require(ggstatsplot)
ggbetweenstats(data=x, x=portuguese, y=adr)
# require(tidyverse)
# countries with at least 100 bookings
xx = x %>% group_by(portuguese) %>% mutate(pais=n()) %>% filter(pais>=100)
xx$portuguese=factor(xx$portuguese)
ggplot(data=xx, aes(x=reorder(portuguese, -pais))) +
geom_bar(stat="count", aes(fill=hotel)) +
theme_light() +
theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust=1))
# require(ggmosaic)
x$is_canceled=as.factor(x$is_canceled)
ggplot(data=x) +
geom_mosaic(aes(x=product(is_canceled, hotel), fill=hotel)) +
theme_light()
ggplot(x, aes(x = hotel, fill = is_canceled)) +
geom_bar(position = "fill") +
scale_y_continuous(labels = scales::percent) +
labs(
title = "Cancellation Rate by Hotel Type",
x = "Hotel Type",
y = "Proportion of Reservations",
fill = "Canceled"
) +
theme_light()
ggplot(x, aes(x = hotel, fill = is_canceled)) +
geom_bar(position = "dodge") +
labs(
x = "Hotel Type",
y = "Number of Reservations",
fill = "Canceled"
) +
theme_light()
ggplot(x, aes(x = hotel, fill = is_canceled)) +
geom_bar() +
labs(
x = "Hotel Type",
y = "Number of Reservations",
fill = "Canceled"
) +
theme_light()
# at least 1000 bookings
xx = x %>% group_by(country) %>% mutate(pais=n()) %>% filter(pais>=1000)
xx$country=factor(xx$country)
ggplot(data=xx) +
geom_mosaic(aes(x=product(is_canceled, country), fill=country)) +
theme_light() +
theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust=1))
# require(lubridate)
x$dia=as_date(paste0(x$arrival_date_year,'-',x$arrival_date_month,'-',x$arrival_date_day_of_month))
ggplot(data=x,aes(x=dia,group=arrival_date_year,color=as.factor(arrival_date_year))) +
geom_bar() + scale_color_manual(values=c("2015"="red","2016"="green","2017"="blue")) +
theme_light() +
theme(legend.position='none')
library(dplyr)
xx2 <- xx %>%
group_by(country) %>%
mutate(cancel_rate = mean(is_canceled == 1)) %>%
ungroup() %>%
mutate(country = reorder(country, cancel_rate))
ggplot(xx2, aes(x = country, fill = is_canceled)) +
geom_bar(position = "fill") +
scale_y_continuous(labels = scales::percent) +
labs(
title = "Cancellation Rate by Country (≥ 1000 Bookings)",
x = "Country",
y = "Proportion of Reservations",
fill = "Canceled"
) +
theme_light() +
theme(
axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 1),
plot.title = element_text(hjust = 0.5, face = "bold")
)
ggplot(xx2, aes(x = country, fill = is_canceled)) +
geom_bar(position = "fill") +
facet_wrap(~ hotel) +
scale_y_continuous(labels = scales::percent) +
labs(
title = "Cancellation Rate by Country and Hotel Type",
x = "Country",
y = "Proportion of Reservations",
fill = "Canceled"
) +
theme_light() +
theme(
axis.text.x = element_text(angle = 90, hjust = 1),
plot.title = element_text(hjust = 0.5, face = "bold")
)
ggplot(xx2, aes(x = country, fill = is_canceled)) +
geom_bar(position = "fill") +
facet_wrap(~ hotel) +
scale_y_continuous(labels = scales::percent) +
labs(
title = "Cancellation Rate by Country and Hotel Type",
x = "Country",
y = "Proportion of Reservations",
fill = "Canceled"
) +
theme_light() +
theme(
axis.text.x = element_text(angle = 90, hjust = 1),
plot.title = element_text(hjust = 0.5, face = "bold")
)
xx3 <- xx %>%
group_by(country, hotel, is_canceled) %>%
summarise(n = n(), .groups = "drop") %>%
group_by(country, hotel) %>%
mutate(prop = n / sum(n))
ggplot(xx3, aes(x = hotel, y = country, fill = prop)) +
geom_tile() +
scale_fill_viridis_c(labels = scales::percent) +
labs(
title = "Proportion of Cancellations by Country and Hotel Type",
x = "Hotel Type",
y = "Country",
fill = "Canceled (%)"
) +
theme_light()
# require(lubridate)
ggplot(
data = x,
aes(x = dia, fill = as.factor(arrival_date_year))
) +
geom_bar() +
facet_wrap(~ hotel, ncol = 1) +
scale_fill_manual(
values = c("2015" = "red", "2016" = "green", "2017" = "blue"),
name = "Year"
) +
labs(
title = "Daily Arrivals by Hotel Type and Year",
x = "Arrival Date",
y = "Number of Bookings"
) +
theme_light() +
theme(
plot.title = element_text(hjust = 0.5, face = "bold"),
axis.text.x = element_text(angle = 45, hjust = 1)
)
# require(lubridate)
top_countries <- x %>%
count(country, sort = TRUE) %>%
slice_head(n = 5) %>%
pull(country)
ggplot(
data = x %>% filter(country %in% top_countries),
aes(x = dia, fill = as.factor(arrival_date_year))
) +
geom_bar() +
facet_wrap(~ country, ncol = 1) +
scale_fill_manual(
values = c("2015" = "red", "2016" = "green", "2017" = "blue"),
name = "Year"
) +
labs(
title = "Daily Arrivals by Country of Origin (Top 5)",
x = "Arrival Date",
y = "Number of Bookings"
) +
theme_light() +
theme(
plot.title = element_text(hjust = 0.5, face = "bold"),
axis.text.x = element_text(angle = 45, hjust = 1)
)
