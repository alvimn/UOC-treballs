require(fitdistrplus)
descdist(x$adr,boot=1000)
require(fitdistrplus)
descdist(x$adr,boot=1000)
x[is.na(x$children),'children']=0
x=x[x$adr>0 &
(x$stays_in_week_nights+x$stays_in_weekend_nights)>0 &
(x$adults+x$children+x$babies)>0 &
!is.na(x$children),]
# require(ggplot2)
ggplot(data=x, aes(x=adr, fill=hotel)) +
geom_histogram(bins=50, colour="black") +
theme_light()
ggplot(data=x, aes(x=hotel, y=adr, fill=hotel)) +
geom_violin() + geom_boxplot(width=.1, outliers = F) +
coord_flip() +
theme_light()
# require(ggplot2)
ggplot(data=x, aes(x=adr, fill=country)) +
geom_histogram(bins=50, colour="black") +
theme_light()
ggplot(data=x, aes(x=country, y=adr, fill=country)) +
geom_violin() + geom_boxplot(width=.1, outliers = F) +
coord_flip() +
theme_light()
# require(ggstatsplot)
ggbetweenstats(data=x, x=hotel, y=adr)
# require(tidyverse)
# countries with at least 100 bookings
xx = x %>% group_by(country) %>% mutate(pais=n()) %>% filter(pais>=100)
xx$country=factor(xx$country)
ggplot(data=xx, aes(x=reorder(country, -pais))) +
geom_bar(stat="count", aes(fill=hotel)) +
theme_light() +
theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust=1))
x <- mutate(x,portuguese = case_when(country == "PRT" ~ 0,
country != "PRT" ~ 1))
# require(ggplot2)
ggplot(data=x, aes(x=adr, fill=portuguese)) +
geom_histogram(bins=50, colour="black") +
theme_light()
x.portuguese
x.portuguese
x <- mutate(x, portuguese = case_when(country == "PRT" ~ 0,
country != "PRT" ~ 1))
x$portuguese
# require(ggplot2)
ggplot(data=x, aes(x=adr, fill=portuguese)) +
geom_histogram(bins=50, colour="black") +
theme_light()
x <- mutate(x, xportuguese = case_when(country == "PRT" ~ "PRT",
country != "PRT" ~ "NPRT"))
# require(ggplot2)
ggplot(data=x, aes(x=adr, fill=portuguese)) +
geom_histogram(bins=50, colour="black") +
